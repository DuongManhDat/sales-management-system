<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.SupplierTabController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm theo mã, tên, SĐT..." HBox.hgrow="ALWAYS" />
        <Button text="+ Thêm nhà cung cấp" onAction="#handleAddSupplier" styleClass="btn-primary" />
    </HBox>

    <TableView fx:id="supplierTable" VBox.vgrow="ALWAYS" styleClass="flat-table">
        <placeholder>
            <Label text="Không có dữ liệu"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="codeColumn" text="Mã NCC" prefWidth="100" />
            <TableColumn fx:id="nameColumn" text="Tên nhà cung cấp" prefWidth="200" />
            <TableColumn fx:id="phoneColumn" text="Điện thoại" prefWidth="120" />
            <TableColumn fx:id="addressColumn" text="Địa chỉ" prefWidth="200" />
            <TableColumn fx:id="noteColumn" text="Ghi chú" prefWidth="150" />
            <TableColumn fx:id="actionColumn" text="Thao tác" prefWidth="150" sortable="false" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Label fx:id="totalLabel" text="Tổng: 0 nhà cung cấp" />
    </HBox>
</VBox>
