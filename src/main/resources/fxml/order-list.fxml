<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="10" stylesheets="@../css/app.css, @../css/pos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.OrderListController" styleClass="pos-root">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
    
    <Label text="Danh sách Đơn Đặt Hàng" styleClass="title-3"/>
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm theo Mã đơn / Khách hàng..." prefWidth="250" styleClass="flat-input" />
        <DatePicker fx:id="dateFilter" promptText="Lọc theo ngày (dd/MM/yyyy)" prefWidth="190" styleClass="flat-input" />
        <Button text="✕" onAction="#handleClearDate" styleClass="btn-icon-square" tooltip="$clearDateTip">
            <tooltip><Tooltip fx:id="clearDateTip" text="Bỏ chọn lọc ngày"/></tooltip>
        </Button>
        <ComboBox fx:id="statusFilter" promptText="Trạng thái" prefWidth="150" styleClass="flat-combo" />
        <Button text="Tải lại" onAction="#loadOrders" styleClass="btn-checkout">
            <graphic>
                <FontIcon iconLiteral="fth-refresh-cw" />
            </graphic>
        </Button>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Hoàn Thành" onAction="#completeOrder" styleClass="btn-outline-primary"/>
        <Button text="Hủy Đơn" onAction="#cancelOrder" styleClass="btn-outline-danger"/>
    </HBox>
    
    <TableView fx:id="orderTable" VBox.vgrow="ALWAYS" styleClass="flat-table">
        <placeholder>
            <Label text="Không có dữ liệu"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã Đơn" prefWidth="120" />
            <TableColumn fx:id="colDate" text="Ngày đặt" prefWidth="120" />
            <TableColumn fx:id="colDelivery" text="Ngày giao" prefWidth="120" />
            <TableColumn fx:id="colCustomer" text="Khách hàng" prefWidth="160" />
            <TableColumn fx:id="colTotal" text="Tổng tiền" prefWidth="120" />
            <TableColumn fx:id="colPaid" text="Đã cọc" prefWidth="100" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="110" />
        </columns>
            <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
