<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="10" stylesheets="@../css/app.css, @../css/pos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.InvoiceListController" styleClass="pos-root">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
    
    <Label text="Danh sách Hóa đơn &amp; Công nợ" styleClass="title-3"/>
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm theo Mã HĐ / Khách hàng..." prefWidth="250" styleClass="flat-input" />
        <DatePicker fx:id="dateFilter" promptText="Lọc theo ngày (dd/MM/yyyy)" prefWidth="190" styleClass="flat-input" />
        <Button text="✕" onAction="#handleClearDate" styleClass="btn-icon-square" tooltip="$clearDateTip">
            <tooltip><Tooltip fx:id="clearDateTip" text="Bỏ chọn lọc ngày"/></tooltip>
        </Button>
        <ComboBox fx:id="statusFilter" promptText="Trạng thái" prefWidth="150" styleClass="flat-combo" />
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnPaymentHistory" text="Lịch sử &amp; Thu nợ" onAction="#handleOpenPaymentHistory" styleClass="btn-primary" style="-fx-background-color: #047857; -fx-text-fill: white; -fx-padding: 8 16; -fx-font-weight: bold;">
            <graphic>
                <FontIcon iconLiteral="fth-dollar-sign" iconColor="white"/>
            </graphic>
        </Button>
    </HBox>
    
    <TableView fx:id="invoiceTable" VBox.vgrow="ALWAYS" styleClass="flat-table">
        <placeholder>
            <Label text="Không có dữ liệu hóa đơn nào." style="-fx-text-fill: #787774;"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã HĐ" prefWidth="120" />
            <TableColumn fx:id="colDate" text="Ngày" prefWidth="130" />
            <TableColumn fx:id="colCustomer" text="Khách hàng" prefWidth="180" />
            <TableColumn fx:id="colTotal" text="Tổng tiền" prefWidth="130" />
            <TableColumn fx:id="colPaid" text="Đã trả" prefWidth="120" />
            <TableColumn fx:id="colDebt" text="Còn nợ" prefWidth="120" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
