<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" style="-fx-background-color: #FBFBFA;" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.InvoicePaymentHistoryController" prefWidth="840" prefHeight="650">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="2">
            <Label text="LỊCH SỬ THANH TOÁN &amp; THU NỢ HÓA ĐƠN" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
            <Label fx:id="lblHeaderSubtitle" text="Mã hóa đơn: - | Khách hàng: -" style="-fx-font-size: 13px; -fx-text-fill: #6B7280;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblInvoiceStatus" text="Trạng thái" style="-fx-padding: 4 12; -fx-background-radius: 4; -fx-font-weight: bold; -fx-font-size: 12px;"/>
    </HBox>

    <!-- Thống kê tài chính Bento Card -->
    <HBox spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 14 16; -fx-border-color: #EAEAEA; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4;">
            <Label text="Tổng tiền hóa đơn" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
            <Label fx:id="lblTotalAmount" text="0 đ" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
        </VBox>

        <VBox spacing="4" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 14 16; -fx-border-color: #EAEAEA; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4;">
            <Label text="Đã thanh toán" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
            <Label fx:id="lblPaidAmount" text="0 đ" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #047857;"/>
        </VBox>

        <VBox spacing="4" HBox.hgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 14 16; -fx-border-color: #EAEAEA; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4;">
            <Label text="Số tiền còn nợ" style="-fx-text-fill: #6B7280; -fx-font-size: 12px;"/>
            <Label fx:id="lblDebtAmount" text="0 đ" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #B91C1C;"/>
        </VBox>
    </HBox>

    <!-- Danh sách lịch sử các đợt trả tiền -->
    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-border-color: #EAEAEA; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4;">
        <Label text="LỊCH SỬ CÁC ĐỢT THANH TOÁN" style="-fx-font-weight: bold; -fx-text-fill: #111111; -fx-font-size: 13px;"/>

        <TableView fx:id="paymentTable" VBox.vgrow="ALWAYS" styleClass="flat-table">
            <placeholder>
                <Label text="Chưa có đợt thanh toán bổ sung nào (đã thanh toán tại quầy hoặc chưa thu)"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colIndex" text="STT" prefWidth="45" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colPaymentDate" text="Ngày thanh toán" prefWidth="140" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colAmount" text="Số tiền trả" prefWidth="130" style="-fx-alignment: CENTER-RIGHT;"/>
                <TableColumn fx:id="colPaymentStatus" text="Trạng thái" prefWidth="110" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colNote" text="Ghi chú / Lý do hủy" prefWidth="240" style="-fx-alignment: CENTER-LEFT;"/>
                <TableColumn fx:id="colAction" text="Thao tác" prefWidth="95" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

    <!-- Khung nhập thu nợ mới -->
    <VBox fx:id="boxCollectDebt" spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 16; -fx-border-color: #EAEAEA; -fx-border-width: 1; -fx-background-radius: 4; -fx-border-radius: 4;">
        <Label text="GHI NHẬN THU NỢ ĐỢT MỚI" style="-fx-font-weight: bold; -fx-text-fill: #111111; -fx-font-size: 13px;"/>

        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="130" prefWidth="130"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints minWidth="120" prefWidth="140"/>
            </columnConstraints>

            <Label text="Số tiền thu (VND):" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-text-fill: #111111;"/>
            <TextField fx:id="txtPaymentAmount" promptText="Nhập số tiền..." GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
            <Button fx:id="btnQuickPayAll" text="Trả hết nợ" onAction="#handleQuickFillDebt" GridPane.columnIndex="2" GridPane.rowIndex="0" styleClass="btn-secondary" maxWidth="Infinity" style="-fx-font-size: 12px;"/>

            <Label text="Ghi chú đợt trả:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #6B7280;"/>
            <TextField fx:id="txtPaymentNote" promptText="VD: Khách chuyển khoản ngân hàng, tiền mặt..." GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2"/>
        </GridPane>
    </VBox>

    <!-- Footer actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="btnConfirmPayment" text="💵 Xác nhận thu nợ" onAction="#handleConfirmPayment" styleClass="btn-primary" style="-fx-background-color: #047857; -fx-text-fill: white; -fx-padding: 8 22; -fx-font-weight: bold;"/>
        <Button text="Đóng" onAction="#handleClose" styleClass="btn-secondary" style="-fx-padding: 8 26;"/>
    </HBox>
</VBox>
