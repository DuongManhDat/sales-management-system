<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox spacing="24" style="-fx-background-color: #FFFFFF; -fx-padding: 32;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.CustomerListController">
    
    <Label text="Khách hàng" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>

    <HBox spacing="16" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm theo tên, SĐT, mã..." prefWidth="300" styleClass="flat-input"/>
        
        <ComboBox fx:id="statusFilterCombo" prefWidth="150" styleClass="flat-input">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Hoạt động"/>
                    <String fx:value="Ngừng hoạt động"/>
                    <String fx:value="Tất cả"/>
                </FXCollections>
            </items>
            <value>
                <String fx:value="Hoạt động"/>
            </value>
        </ComboBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Button text="Export" styleClass="btn-secondary" onAction="#handleExport"/>
        <Button text="Import" styleClass="btn-secondary" onAction="#handleImport"/>
        <Button text="+ Thêm mới" styleClass="btn-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" styleClass="flat-table">
        <placeholder>
            <Label text="Không có dữ liệu"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã KH" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Họ tên" prefWidth="200"/>
            <TableColumn fx:id="colPhone" text="Số điện thoại" prefWidth="150"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
            <TableColumn fx:id="colDebt" text="Công nợ" prefWidth="150"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="120"/>
            <TableColumn fx:id="colAction" text="Thao tác" prefWidth="200" sortable="false"/>
        </columns>
    </TableView>
</VBox>
