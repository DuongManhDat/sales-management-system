<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox styleClass="view-container" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.ProductListController">
    
    <Label text="Hàng hóa" styleClass="view-title"/>

    <HBox styleClass="view-toolbar">
        <TextField fx:id="searchField" promptText="Tìm theo tên, mã..." prefWidth="300" styleClass="flat-input"/>
        
        <ComboBox fx:id="categoryCombo" prefWidth="150" styleClass="flat-input">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Tất cả"/>
                </FXCollections>
            </items>
            <value>
                <String fx:value="Tất cả"/>
            </value>
        </ComboBox>

        <ComboBox fx:id="statusFilterCombo" prefWidth="150" styleClass="flat-input">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Hoạt động"/>
                    <String fx:value="Tạm ngưng"/>
                    <String fx:value="Tất cả"/>
                </FXCollections>
            </items>
            <value>
                <String fx:value="Hoạt động"/>
            </value>
        </ComboBox>
        
        <Region HBox.hgrow="ALWAYS" />
        
        <Button text="Lịch sử giá" styleClass="btn-outline-dark" onAction="#handlePriceHistory"/>
        <Button text="Kiểm kho" styleClass="btn-outline-dark" onAction="#handleStockAdjustment"/>
        <Button text="Tải file mẫu" styleClass="btn-outline-dark" onAction="#handleDownloadTemplate"/>
        <Button text="Xuất Excel" styleClass="btn-outline-success" onAction="#handleExport"/>
        <Button text="Nhập Excel" styleClass="btn-outline-success" onAction="#handleImport"/>
        <Button text="+ Thêm mới" styleClass="btn-outline-primary" onAction="#handleAdd"/>
    </HBox>

    <TableView fx:id="productTable" VBox.vgrow="ALWAYS" styleClass="flat-table">
        <placeholder>
            <Label text="Không có dữ liệu"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã hàng" prefWidth="100"/>
            <TableColumn fx:id="colName" text="Tên hàng hóa" prefWidth="250"/>
            <TableColumn fx:id="colUnit" text="Đơn vị" prefWidth="100"/>
            <TableColumn fx:id="colCategory" text="Danh mục" prefWidth="150"/>
            <TableColumn fx:id="colPrice" text="Giá bán" prefWidth="120"/>
            <TableColumn fx:id="colStock" text="Tồn kho" prefWidth="100"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="100"/>
            <TableColumn fx:id="colAction" text="Thao tác" prefWidth="90" sortable="false" style="-fx-alignment: CENTER;"/>
        </columns>
            <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
