<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="16" style="-fx-background-color: #FBFBFA;" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.ReturnDetailController" prefWidth="900" prefHeight="640">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="CHI TIẾT PHIẾU TRẢ HÀNG" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="4">
            <Label fx:id="lblStatus" text="Trạng thái" style="-fx-padding: 4 12; -fx-background-radius: 4; -fx-font-weight: bold;"/>
            <Label fx:id="lblCanceledAt" text="Thời gian hủy: -" visible="false" managed="false" style="-fx-text-fill: #dc2626; -fx-font-size: 12px; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Thông tin phiếu trả -->
    <GridPane hgap="24" vgap="12" styleClass="bento-card">
        <columnConstraints>
            <ColumnConstraints minWidth="100" prefWidth="110"/>
            <ColumnConstraints percentWidth="38" hgrow="ALWAYS"/>
            <ColumnConstraints minWidth="100" prefWidth="110"/>
            <ColumnConstraints percentWidth="38" hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Mã phiếu trả:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
        <Label fx:id="lblCode" text="-" style="-fx-font-weight: bold; -fx-text-fill: #111111;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Ngày trả:" GridPane.columnIndex="2" GridPane.rowIndex="0" style="-fx-text-fill: #6b7280;"/>
        <Label fx:id="lblDate" text="-" style="-fx-text-fill: #111111;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Hóa đơn gốc:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #6b7280; -fx-font-weight: bold;"/>
        <Label fx:id="lblInvoiceCode" text="-" style="-fx-font-weight: bold; -fx-text-fill: #2563EB;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Khách hàng:" GridPane.columnIndex="2" GridPane.rowIndex="1" style="-fx-text-fill: #6b7280;"/>
        <Label fx:id="lblCustomer" text="-" style="-fx-text-fill: #111111; -fx-font-weight: bold;" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
    </GridPane>

    <!-- Bảng danh sách hàng hóa hoàn trả -->
    <VBox spacing="10" styleClass="bento-card" VBox.vgrow="ALWAYS">
        <Label text="DANH SÁCH HÀNG HÓA HOÀN TRẢ" style="-fx-font-weight: bold; -fx-text-fill: #111111;"/>

        <TableView fx:id="tableItems" VBox.vgrow="ALWAYS" styleClass="table-view">
            <placeholder>
                <Label text="Không có sản phẩm nào"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="colIndex" text="STT" prefWidth="50" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colProductCode" text="Mã SP" prefWidth="130" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colProductName" text="Tên hàng hóa" prefWidth="250" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colUnitName" text="ĐVT" prefWidth="80" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colReturnQty" text="Số lượng trả" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                <TableColumn fx:id="colRefundPrice" text="Đơn giá bán" prefWidth="130" style="-fx-alignment: CENTER_RIGHT;"/>
                <TableColumn fx:id="colAmount" text="Thành tiền hoàn" prefWidth="140" style="-fx-alignment: CENTER_RIGHT;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Thống kê tài chính hoàn tiền -->
        <HBox spacing="32" alignment="CENTER_RIGHT" style="-fx-padding: 8 0 0 0;">
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label text="Tổng tiền hàng:" style="-fx-text-fill: #6b7280;"/>
                <Label fx:id="lblGrossRefund" text="0 đ" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #111111;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label text="Phí trả hàng:" style="-fx-text-fill: #6b7280;"/>
                <Label fx:id="lblReturnFee" text="0 đ" style="-fx-font-weight: bold; -fx-font-size: 15px; -fx-text-fill: #6b7280;"/>
            </HBox>
            <HBox spacing="8" alignment="CENTER_RIGHT">
                <Label text="Thực hoàn khách:" style="-fx-text-fill: #111111; -fx-font-weight: bold;"/>
                <Label fx:id="lblNetRefund" text="0 đ" style="-fx-font-weight: bold; -fx-font-size: 17px; -fx-text-fill: #DC2626;"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Nút thao tác -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="btnRecreate" text="Tạo từ phiếu cũ" onAction="#handleRecreate" styleClass="btn-primary" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-padding: 8 20; -fx-font-weight: bold;">
            <graphic>
                <FontIcon iconLiteral="fth-copy" iconColor="white"/>
            </graphic>
        </Button>
        <Button fx:id="btnCancelReturn" text="Hủy phiếu" onAction="#handleCancelReturn" styleClass="btn-danger" style="-fx-padding: 8 20; -fx-font-weight: bold;">
            <graphic>
                <FontIcon iconLiteral="fth-slash" iconColor="#DC2626"/>
            </graphic>
        </Button>
        <Button text="Đóng" onAction="#handleClose" styleClass="btn-secondary" style="-fx-padding: 8 24;"/>
    </HBox>
</VBox>
