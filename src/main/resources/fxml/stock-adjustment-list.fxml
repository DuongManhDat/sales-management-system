<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="view-container" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.StockAdjustmentListController">

    <Label text="Lịch sử kiểm kho" styleClass="view-title" />

    <HBox styleClass="view-toolbar">
        <TextField fx:id="searchCodeField" promptText="Lọc theo mã phiếu..." prefWidth="250.0" styleClass="flat-input" />
        <DatePicker fx:id="dateFilter" promptText="Lọc theo ngày (dd/MM/yyyy)" prefWidth="190.0" styleClass="flat-input" />
        <Button onAction="#handleClearDate" styleClass="btn-icon-square" text="✕" tooltip="$clearDateTip">
            <tooltip><Tooltip fx:id="clearDateTip" text="Bỏ chọn lọc ngày" /></tooltip>
        </Button>
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCreateAdjustment" styleClass="btn-outline-primary" text="+ Thêm mới" />
    </HBox>

    <TableView fx:id="tableAdjustments" prefHeight="600.0" VBox.vgrow="ALWAYS" styleClass="table-view">
        <placeholder><Label text="Không có dữ liệu"/></placeholder>
        <columns>
            <TableColumn fx:id="colCode" prefWidth="150.0" text="Mã Phiếu" />
            <TableColumn fx:id="colDate" prefWidth="200.0" text="Ngày tạo" />
            <TableColumn fx:id="colNote" prefWidth="400.0" text="Ghi chú" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
