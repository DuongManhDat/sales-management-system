<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" style="-fx-background-color: #f3f4f6;" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.StockAdjustmentListController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Lịch sử kiểm kho" />
        <Label fx:id="lblTotal" style="-fx-text-fill: #6b7280; -fx-font-size: 14px;" text="Tổng số: 0 phiếu" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCreateAdjustment" styleClass="btn-primary" text="Tạo phiếu kiểm kho" />
        <Button onAction="#handleRefresh" styleClass="btn-secondary" text="Làm mới" />
    </HBox>

    <TableView fx:id="tableAdjustments" prefHeight="600.0" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colCode" prefWidth="150.0" text="Mã Phiếu" />
            <TableColumn fx:id="colDate" prefWidth="200.0" text="Ngày tạo" />
            <TableColumn fx:id="colNote" prefWidth="400.0" text="Ghi chú" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
