<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="view-container" stylesheets="@../css/app.css, @../css/pos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.ReturnListController">

    <!-- Header Title -->
    <Label text="Trả hàng" styleClass="view-title"/>

    <!-- Filter Bar / Toolbar -->
    <HBox styleClass="view-toolbar">
        <TextField fx:id="txtFilterReturnCode" promptText="Lọc mã phiếu..." prefWidth="150" styleClass="flat-input"/>
        <TextField fx:id="txtFilterInvoiceCode" promptText="Lọc mã HĐ gốc..." prefWidth="150" styleClass="flat-input"/>
        <TextField fx:id="txtFilterCustomer" promptText="Lọc khách hàng..." prefWidth="180" styleClass="flat-input"/>
        <DatePicker fx:id="dpFilterReturnDate" promptText="Lọc ngày trả (dd/MM/yyyy)" prefWidth="180" styleClass="flat-input"/>
        <Button text="✕" onAction="#handleClearDate" styleClass="btn-icon-square" tooltip="$clearDateTip">
            <tooltip><Tooltip fx:id="clearDateTip" text="Bỏ chọn lọc ngày"/></tooltip>
        </Button>
        <ComboBox fx:id="cbFilterStatus" prefWidth="130" promptText="Trạng thái" styleClass="flat-input"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="+ Thêm mới" onAction="#openReturnForm" styleClass="btn-outline-primary">
            <graphic>
                <FontIcon iconLiteral="fth-plus" iconColor="#2563EB"/>
            </graphic>
        </Button>
    </HBox>

    <!-- Table: Mã Phiếu, Hóa đơn gốc, Khách hàng, Ngày trả và Trạng thái -->
    <TableView fx:id="returnTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <placeholder>
            <Label text="Chưa có dữ liệu phiếu trả hàng nào." style="-fx-text-fill: #787774;"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã Phiếu" prefWidth="180" style="-fx-alignment: CENTER; -fx-font-weight: bold;" />
            <TableColumn fx:id="colInvoiceCode" text="Hóa đơn gốc" prefWidth="180" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colCustomer" text="Khách hàng" prefWidth="240" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colDate" text="Ngày trả" prefWidth="170" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="140" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
