<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="10" stylesheets="@../css/app.css, @../css/pos.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.ReturnListController" styleClass="pos-root">
    <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
    
    <Label text="Danh sách Phiếu Trả Hàng" styleClass="title-3"/>
    
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Tải lại" onAction="#loadReturns" styleClass="btn-checkout">
            <graphic>
                <FontIcon iconLiteral="fth-refresh-cw" />
            </graphic>
        </Button>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button text="Thêm Phiếu Trả" onAction="#openReturnForm" styleClass="btn-outline-primary"/>
    </HBox>
    
    <TableView fx:id="returnTable" VBox.vgrow="ALWAYS" styleClass="flat-table">
        <placeholder>
            <Label text="Không có dữ liệu"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã Phiếu" prefWidth="120" />
            <TableColumn fx:id="colInvoiceId" text="Hóa Đơn Gốc" prefWidth="120" />
            <TableColumn fx:id="colDate" text="Ngày Trả" prefWidth="150" />
            <TableColumn fx:id="colCustomer" text="Khách hàng (ID)" prefWidth="120" />
            <TableColumn fx:id="colTotalRefund" text="Tổng Hoàn" prefWidth="120" />
            <TableColumn fx:id="colFee" text="Phí" prefWidth="100" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="100" />
        </columns>
            <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
