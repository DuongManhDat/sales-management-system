<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="16" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.ActivityLogTabController" style="-fx-padding: 20; -fx-background-color: #ffffff;">
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="Nhật Ký Hoạt Động" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #111827;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Làm mới" onAction="#handleRefresh" style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 4; -fx-border-color: #d1d5db; -fx-border-radius: 4; -fx-cursor: hand;" />
    </HBox>

    <TableView fx:id="logTable" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: #e5e7eb; -fx-border-radius: 4;">
        <columns>
            <TableColumn fx:id="colTime" text="Thời gian" prefWidth="150" />
            <TableColumn fx:id="colAction" text="Hành động" prefWidth="120" />
            <TableColumn fx:id="colEntity" text="Đối tượng" prefWidth="120" />
            <TableColumn fx:id="colEntityId" text="ID Đối tượng" prefWidth="100" />
            <TableColumn fx:id="colDetail" text="Chi tiết" prefWidth="400" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
