<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.SettingsController">
    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>
            <Tab text="Đơn vị tính">
                <content>
                    <fx:include source="unit-tab.fxml" />
                </content>
            </Tab>
            <Tab text="Nhóm hàng">
                <content>
                    <fx:include source="category-tab.fxml" />
                </content>
            </Tab>
            <Tab text="Nhà cung cấp">
                <content>
                    <fx:include source="supplier-tab.fxml" />
                </content>
            </Tab>
            <Tab text="Nhật ký hoạt động">
                <content>
                    <fx:include source="activity-log-tab.fxml" />
                </content>
            </Tab>
            <Tab text="Hệ thống (Sao lưu)">
                <content>
                    <fx:include source="backup-restore-tab.fxml" />
                </content>
            </Tab>
        </tabs>
    </TabPane>
</VBox>
