<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" styleClass="bento-card" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.PurchaseListController">
    <padding>
        <Insets top="24" right="32" bottom="24" left="32"/>
    </padding>

    <!-- Toolbar -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="MUA HÀNG" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>
        <Region HBox.hgrow="ALWAYS" />
        <TextField fx:id="searchField" promptText="Tìm mã phiếu / NCC..." prefWidth="240" styleClass="flat-input"/>
        <ComboBox fx:id="statusFilter" prefWidth="140" promptText="Trạng thái" />
        <Button text="📥 Tải file mẫu" styleClass="btn-secondary" onAction="#handleDownloadTemplate" />
        <Button text="📤 Import Excel" styleClass="btn-primary" onAction="#handleImportPurchases" />
        <Button text="📊 Xuất danh sách" styleClass="btn-secondary" onAction="#handleExportPurchases" />
    </HBox>

    <!-- Table -->
    <TableView fx:id="purchaseTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <placeholder>
            <Label text="Không có dữ liệu phiếu nhập nào." style="-fx-text-fill: #787774;"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã phiếu" prefWidth="140" style="-fx-alignment: CENTER_LEFT;" />
            <TableColumn fx:id="colDate" text="Ngày nhập" prefWidth="140" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colSupplier" text="Nhà cung cấp" prefWidth="230" style="-fx-alignment: CENTER_LEFT;" />
            <TableColumn fx:id="colTotal" text="Tổng nhập" prefWidth="140" style="-fx-alignment: CENTER_RIGHT;" />
            <TableColumn fx:id="colDebt" text="Còn nợ" prefWidth="130" style="-fx-alignment: CENTER_RIGHT;" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colAction" text="Thao tác" prefWidth="90" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
