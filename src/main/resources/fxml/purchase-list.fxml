<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox styleClass="view-container" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.PurchaseListController">

    <!-- Header Title -->
    <Label text="Nhập hàng" styleClass="view-title"/>

    <!-- Toolbar -->
    <HBox styleClass="view-toolbar">
        <TextField fx:id="searchField" promptText="Tìm mã phiếu / NCC..." prefWidth="240" styleClass="flat-input"/>
        <ComboBox fx:id="statusFilter" prefWidth="140" promptText="Trạng thái" styleClass="flat-input"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Tải file mẫu" styleClass="btn-outline-dark" onAction="#handleDownloadTemplate" />
        <Button text="Nhập Excel" styleClass="btn-outline-success" onAction="#handleImportPurchases" />
        <Button text="Xuất Excel" styleClass="btn-outline-success" onAction="#handleExportPurchases" />
        <Button text="+ Thêm mới" styleClass="btn-outline-primary" onAction="#handleCreatePurchase" />
    </HBox>

    <!-- Table -->
    <TableView fx:id="purchaseTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <placeholder>
            <Label text="Không có dữ liệu phiếu nhập nào." style="-fx-text-fill: #787774;"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="colCode" text="Mã phiếu" prefWidth="140" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colDate" text="Ngày nhập" prefWidth="140" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colSupplier" text="Nhà cung cấp" prefWidth="230" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colTotal" text="Tổng nhập" prefWidth="140" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colDebt" text="Còn nợ" prefWidth="130" style="-fx-alignment: CENTER;" />
            <TableColumn fx:id="colStatus" text="Trạng thái" prefWidth="130" style="-fx-alignment: CENTER;" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
</VBox>
