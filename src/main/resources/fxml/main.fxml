<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.HBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane fx:id="mainPane" prefHeight="768.0" prefWidth="1024.0" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.MainController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="app-header">
            <Button onAction="#toggleSidebar" styleClass="flat, title-4">
                <graphic>
                    <FontIcon iconLiteral="fth-menu" />
                </graphic>
            </Button>
            <Label styleClass="title-4" text="Hệ thống Quản lý Bán hàng" />
        </HBox>
    </top>
    <left>
        <VBox fx:id="sidebar" prefWidth="220.0" spacing="4.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="12.0" right="12.0" top="20.0" />
            </padding>
            <Button maxWidth="Infinity" onAction="#showDashboard" styleClass="sidebar-btn" text=" Dashboard">
                <graphic>
                    <FontIcon iconLiteral="fth-grid" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" onAction="#showProducts" styleClass="sidebar-btn" text=" Hàng hóa">
                <graphic>
                    <FontIcon iconLiteral="fth-box" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" onAction="#showCustomers" styleClass="sidebar-btn" text=" Khách hàng">
                <graphic>
                    <FontIcon iconLiteral="fth-users" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" onAction="#showPurchases" styleClass="sidebar-btn" text=" Mua hàng">
                <graphic>
                    <FontIcon iconLiteral="fth-shopping-cart" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" onAction="#showSales" styleClass="sidebar-btn" text=" Bán hàng">
                <graphic>
                    <FontIcon iconLiteral="fth-shopping-bag" />
                </graphic>
            </Button>
            <Button maxWidth="Infinity" onAction="#showSettings" styleClass="sidebar-btn" text=" Thiết lập">
                <graphic>
                    <FontIcon iconLiteral="fth-settings" />
                </graphic>
            </Button>
        </VBox>
    </left>
    <center>
        <Label text="Chào mừng đến với Hệ thống Quản lý Bán hàng" BorderPane.alignment="CENTER">
            <font>
                <Font size="24.0" />
            </font>
        </Label>
    </center>
</BorderPane>
