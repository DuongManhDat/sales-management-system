<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="680.0" prefWidth="1200.0" spacing="16.0" style="-fx-background-color: #FFFFFF; -fx-padding: 24;" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.CustomerImportDialogController">

    <!-- Header bar -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Xem trước dữ liệu Nhập khách hàng" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#handleDownloadTemplate" styleClass="btn-secondary" text="📥 Tải file mẫu Excel" />
    </HBox>

    <!-- Status Banner Box -->
    <VBox fx:id="bannerBox" spacing="6.0" style="-fx-padding: 14; -fx-background-radius: 4; -fx-border-radius: 4; -fx-border-width: 1;">
        <Label fx:id="lblBannerTitle" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Trạng thái kiểm tra dữ liệu" />
        <Label fx:id="lblBannerDesc" style="-fx-font-size: 13px;" text="Chi tiết kết quả kiểm tra..." wrapText="true" />
    </VBox>

    <!-- Table of records -->
    <TableView fx:id="tableView" styleClass="flat-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colRow" prefWidth="55.0" text="Dòng" />
            <TableColumn fx:id="colCode" prefWidth="95.0" text="Mã KH" />
            <TableColumn fx:id="colName" prefWidth="170.0" text="Họ và tên" />
            <TableColumn fx:id="colPhone" prefWidth="110.0" text="Số điện thoại" />
            <TableColumn fx:id="colEmail" prefWidth="140.0" text="Email" />
            <TableColumn fx:id="colDob" prefWidth="95.0" text="Ngày sinh" />
            <TableColumn fx:id="colGender" prefWidth="75.0" text="Giới tính" />
            <TableColumn fx:id="colAddress" prefWidth="150.0" text="Địa chỉ" />
            <TableColumn fx:id="colNote" prefWidth="110.0" text="Ghi chú" />
            <TableColumn fx:id="colError" minWidth="300.0" prefWidth="420.0" text="Nguyên nhân lỗi" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <!-- Bottom Actions -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <ProgressIndicator fx:id="progressIndicator" managed="false" prefHeight="24.0" prefWidth="24.0" visible="false" />
        <Label fx:id="lblProgress" style="-fx-text-fill: #4B5563; -fx-font-size: 13px;" text="" />
        <Pane HBox.hgrow="ALWAYS" />
        <Button onAction="#handleCancel" styleClass="btn-secondary" text="Hủy bỏ" />
        <Button fx:id="btnConfirm" onAction="#handleConfirmImport" styleClass="btn-primary" text="Xác nhận Import" />
    </HBox>

</VBox>
