<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.SetupController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
    </padding>

    <Label text="Thiết lập mật khẩu lần đầu">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <PasswordField fx:id="passwordField" promptText="Mật khẩu mới"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Nhập lại mật khẩu" onAction="#onSetupButtonClick"/>
    
    <Label fx:id="errorLabel" textFill="red" visible="false" wrapText="true"/>
    
    <Button fx:id="setupButton" text="Lưu mật khẩu" onAction="#onSetupButtonClick" defaultButton="true"/>
    
    <ProgressIndicator fx:id="progressIndicator" visible="false"/>
</VBox>
