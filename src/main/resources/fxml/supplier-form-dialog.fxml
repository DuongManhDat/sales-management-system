<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="20" style="-fx-background-color: #FFFFFF; -fx-padding: 32;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.SupplierFormDialogController">
    
    <Label fx:id="lblTitle" text="Thêm nhà cung cấp mới" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111111;"/>

    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints minWidth="120" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        
        <Label text="Mã NCC:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #555555;"/>
        <TextField fx:id="txtCode" promptText="Để trống để tự động sinh mã" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="flat-input"/>
        
        <Label text="Tên NCC (*):" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #555555;"/>
        <TextField fx:id="txtName" promptText="Công ty TNHH ABC" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="flat-input"/>
        
        <Label text="Điện thoại (*):" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #555555;"/>
        <TextField fx:id="txtPhone" promptText="090xxxxxxx" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="flat-input"/>

        <Label text="Địa chỉ:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #555555;"/>
        <TextField fx:id="txtAddress" promptText="Số nhà, đường..." GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="flat-input"/>
        
        <Label text="Ghi chú:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-text-fill: #555555;"/>
        <TextArea fx:id="txtNote" prefRowCount="3" promptText="Ghi chú thêm..." GridPane.rowIndex="4" GridPane.columnIndex="1" styleClass="flat-input"/>
        
        <Label text="Trạng thái:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-text-fill: #555555;"/>
        <CheckBox fx:id="chkActive" text="Hoạt động" selected="true" GridPane.rowIndex="5" GridPane.columnIndex="1" style="-fx-text-fill: #111111;"/>
    </GridPane>

    <HBox spacing="16" alignment="CENTER_RIGHT" style="-fx-padding: 16 0 0 0;">
        <Button text="Hủy" styleClass="btn-secondary" onAction="#handleCancel"/>
        <Button fx:id="btnSave" text="Lưu" styleClass="btn-primary" onAction="#handleSave"/>
    </HBox>
</VBox>
