<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.UnitTabController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Tìm đơn vị..." HBox.hgrow="ALWAYS" />
        <Button text="+ Thêm đơn vị" onAction="#handleAddUnit" styleClass="accent" />
    </HBox>

    <TableView fx:id="unitTable" VBox.vgrow="ALWAYS">
        <placeholder>
            <Label text="Không có dữ liệu"/>
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Tên đơn vị" prefWidth="200" />
            <TableColumn fx:id="statusColumn" text="Trạng thái" prefWidth="100" />
            <TableColumn fx:id="actionColumn" text="Thao tác" prefWidth="150" />
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT">
        <Label fx:id="totalLabel" text="Tổng: 0 đơn vị" />
    </HBox>
</VBox>
