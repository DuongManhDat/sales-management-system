<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16.0" style="-fx-background-color: #ffffff;" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.shop.controller.StockAdjustmentDetailController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #111111;" text="Chi tiết Phiếu Kiểm Kho" />

    <GridPane hgap="16.0" vgap="8.0">
        <Label style="-fx-text-fill: #6b7280;" text="Mã phiếu:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label fx:id="lblCode" style="-fx-font-weight: bold; -fx-text-fill: #111111;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label style="-fx-text-fill: #6b7280;" text="Ngày tạo:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label fx:id="lblDate" style="-fx-text-fill: #111111;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label style="-fx-text-fill: #6b7280;" text="Ghi chú:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Label fx:id="lblNote" style="-fx-text-fill: #111111;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <TableView fx:id="tableItems" prefHeight="400.0" prefWidth="800.0" VBox.vgrow="ALWAYS" styleClass="table-view">
        <placeholder><Label text="Không có dữ liệu"/></placeholder>
        <columns>
            <TableColumn fx:id="colProductCode" prefWidth="120.0" text="Mã HH" />
            <TableColumn fx:id="colProductName" prefWidth="200.0" text="Tên HH" />
            <TableColumn fx:id="colCurrentQty" prefWidth="100.0" text="Tồn lúc kiểm" />
            <TableColumn fx:id="colActualQty" prefWidth="100.0" text="Thực tế" />
            <TableColumn fx:id="colVariance" prefWidth="100.0" text="Chênh lệch" />
            <TableColumn fx:id="colReason" prefWidth="180.0" text="Lý do" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <Button onAction="#handleClose" styleClass="btn-secondary" text="Đóng" />
    </HBox>
</VBox>
